# Build the worker from committed source first; use a verified local build tag.
# Dockerfile FROM cannot resolve a bare local sha256 image ID with BuildKit.
# Verify that tag's image ID before/after build; runtime parser_image MUST be sha256.
ARG WORKER_IMAGE
FROM ${WORKER_IMAGE}
USER root
COPY demo_import_archive.py demo_import_parser.py /opt/director/
# Official 7-Zip binary/license are verified staging inputs, never Git secrets.
COPY import-tool/7zz import-tool/License.txt /opt/director/
RUN chmod 755 /opt/director/7zz
USER 10001:10001
ENTRYPOINT ["python", "/opt/director/demo_import_parser.py"]
CMD ["--folder", "/work", "--seven-zip", "/opt/director/7zz"]
