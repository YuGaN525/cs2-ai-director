{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "suiteVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "splitHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "testRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "positiveRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "balancedAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "suiteVersion",
        "splitHash",
        "testRows",
        "positiveRows",
        "balancedAccuracy",
        "notes"
      ],
      "additionalProperties": false
    },
    "vectors": {
      "type": "array",
      "minItems": 8,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "features": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "number"
            }
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "features",
          "probability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "artifactSha256",
    "evaluation",
    "vectors"
  ],
  "additionalProperties": false
}
