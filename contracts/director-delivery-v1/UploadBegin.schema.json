{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batchId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "online",
        "offline"
      ]
    },
    "uploadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uploadBytes": {
      "type": "integer",
      "minimum": 18,
      "maximum": 8388608
    },
    "partCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rowSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "recordId",
          "sourceId",
          "sequence",
          "rowSha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "batchId",
    "source",
    "uploadSha256",
    "uploadBytes",
    "partCount",
    "samples"
  ],
  "additionalProperties": false
}
