  "components": {
    "securitySchemes": {
      "device": {
        "type": "http",
        "scheme": "bearer"
      },
      "website": {
        "type": "http",
        "scheme": "bearer"
      },
      "worker": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Director-Worker-Key"
      }
    },
    "schemas": {
      "ModelRegister": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "suiteVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "splitHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "testRows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "positiveRows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "balancedAccuracy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "notes": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "suiteVersion",
              "splitHash",
              "testRows",
              "positiveRows",
              "balancedAccuracy",
              "notes"
            ],
            "additionalProperties": false
          },
          "vectors": {
            "type": "array",
            "minItems": 8,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "features": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "items": {
                    "type": "number"
                  }
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "features",
                "probability"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "artifactSha256",
          "evaluation",
          "vectors"
        ],
        "additionalProperties": false
      },
      "UploadBegin": {
        "type": "object",
        "properties": {
          "batchId": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "enum": [
              "online",
              "offline"
            ]
          },
          "uploadSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uploadBytes": {
            "type": "integer",
            "minimum": 18,
            "maximum": 8388608
          },
          "partCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "rowSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "recordId",
                "sourceId",
                "sequence",
                "rowSha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "batchId",
          "source",
          "uploadSha256",
          "uploadBytes",
          "partCount",
          "samples"
        ],
        "additionalProperties": false
      },
      "UploadReceipt": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "clientBatchId": {
            "type": "string",
            "format": "uuid"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uploadHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dataBatchId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "acceptedRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duplicateRows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "enum": [
              "online",
              "offline"
            ]
          },
          "quality": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "uploadId",
          "clientBatchId",
          "requestHash",
          "uploadHash",
          "dataBatchId",
          "rowCount",
          "acceptedRows",
          "duplicateRows",
          "source",
          "quality",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "ReleaseChange": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedSequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "requestId",
          "expectedSequence",
          "reason"
        ],
        "additionalProperties": false
      },
      "QualityReview": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "ready",
              "quarantined",
              "deleted"
            ]
          },
          "matchHash": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "expectedVersion",
          "state",
          "matchHash",
          "note"
        ],
        "additionalProperties": false
      },
      "SnapshotCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "batchIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "demoIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "name",
          "batchIds",
          "demoIds"
        ],
        "additionalProperties": false
      },
      "JobCreate": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "snapshotId": {
            "type": "string",
            "format": "uuid"
          },
          "baselineModelId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "trees": {
                "type": "integer",
                "minimum": 10,
                "maximum": 300
              },
              "maxDepth": {
                "type": "integer",
                "minimum": 2,
                "maximum": 16
              },
              "seed": {
                "const": 42
              },
              "maxSeconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 7200
              },
              "maxMemoryMb": {
                "type": "integer",
                "minimum": 512,
                "maximum": 4096
              }
            },
            "required": [
              "trees",
              "maxDepth",
              "seed",
              "maxSeconds",
              "maxMemoryMb"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "requestId",
          "snapshotId",
          "baselineModelId",
          "parameters"
        ],
        "additionalProperties": false
      }
    }
  }
}
