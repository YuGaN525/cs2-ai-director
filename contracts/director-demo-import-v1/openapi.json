    "/api/admin/director-imports/files/{id}/parts/{index}": {
      "put": {
        "summary": "Exact Content-Length and SHA-256; 8 MiB maximum",
        "security": [
          {
            "WebsiteBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "ApiResponse data; accepted analysis is asynchronous"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Current database permission denied"
          },
          "409": {
            "description": "Version, lease or content conflict"
          },
          "413": {
            "description": "Declared resource limit"
          },
          "422": {
            "description": "SHA mismatch"
          },
          "429": {
            "description": "Capacity/concurrency backpressure"
          },
          "503": {
            "description": "Disabled or storage unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "generation",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "sha256",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ]
      }
    },
