{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5960
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8388608
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "index",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false
}
