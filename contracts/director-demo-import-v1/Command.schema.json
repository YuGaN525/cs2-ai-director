{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "requestId",
    "expectedVersion",
    "reason"
  ],
  "additionalProperties": false
}
