{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "ignored"
      ]
    },
    "rawHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "rawBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parserVersion": {
      "type": "string"
    },
    "rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "positive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19999
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "index",
          "sha256",
          "bytes",
          "rows"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20000
    },
    "report": {
      "type": "object"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{0,120}$"
    }
  },
  "required": [
    "path",
    "state",
    "rawHash",
    "rawBytes",
    "parserVersion",
    "rows",
    "positive",
    "parts",
    "report",
    "errorCode"
  ],
  "additionalProperties": false
}
