{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "director-training-dataset-v1"
    },
    "clientDatasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "governanceStatus": {
      "type": "string",
      "enum": [
        "pending-review",
        "partially-included",
        "included",
        "excluded",
        "blocked"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending-review",
              "included",
              "excluded",
              "blocked"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SOURCE_UNVERIFIED",
                "SOURCE_MISSING",
                "READER_UNAVAILABLE",
                "OBJECT_UNAVAILABLE",
                "QUALITY_REJECTED",
                "LEGACY_PROVENANCE_INCOMPLETE"
              ]
            },
            "minItems": 0,
            "maxItems": 6
          }
        },
        "required": [
          "sourceId",
          "status",
          "blockers"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "clientDatasetId",
    "datasetId",
    "revision",
    "governanceStatus",
    "sources"
  ],
  "additionalProperties": false
}
