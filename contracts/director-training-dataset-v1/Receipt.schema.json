{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "director-training-dataset-v1"
    },
    "clientDatasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receivedFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "receivedRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000
    },
    "acceptedRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "duplicateRows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200000
    },
    "receivedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "initialGovernanceStatus": {
      "const": "pending-review"
    }
  },
  "required": [
    "schema",
    "clientDatasetId",
    "datasetId",
    "manifestSha256",
    "requestHash",
    "receivedFiles",
    "receivedRows",
    "acceptedRows",
    "duplicateRows",
    "receivedAt",
    "initialGovernanceStatus"
  ],
  "additionalProperties": false
}
