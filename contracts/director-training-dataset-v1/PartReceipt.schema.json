{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "director-training-dataset-v1"
    },
    "clientDatasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "fileIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1023
    },
    "partIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "clientDatasetId",
    "fileIndex",
    "partIndex",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false
}
