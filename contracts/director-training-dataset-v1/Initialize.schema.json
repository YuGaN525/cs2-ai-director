{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "director-training-dataset-v1"
    },
    "clientDatasetId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "director-training-dataset-v1"
        },
        "version": {
          "const": 1
        },
        "producerVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "featureVersion": {
          "const": "pov-v1"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "demo-derived",
                  "legacy-offline",
                  "legacy-selected-only"
                ]
              },
              "rowSchema": {
                "type": "string",
                "enum": [
                  "demo-live36-v1",
                  "legacy26-v1"
                ]
              },
              "rawDemoSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recordingId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "declaredMatchGroup": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "identityQuality": {
                "type": "string",
                "enum": [
                  "recording-only",
                  "filename-inferred",
                  "user-declared",
                  "unknown"
                ]
              },
              "parserVersion": {
                "anyOf": [
                  {
                    "const": "demo-v2-live.1"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sampling": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "method": {
                        "const": "periodic-live"
                      },
                      "stepTicks": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "horizonTicks": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "tickrateAssumption": {
                        "const": 64
                      },
                      "labelDefinition": {
                        "const": "damage_or_kill_in_(tick,tick+horizon]"
                      },
                      "missingFields": {
                        "const": "armor_helmet_flash_defuse_bomb_ammo_approx"
                      }
                    },
                    "required": [
                      "method",
                      "stepTicks",
                      "horizonTicks",
                      "tickrateAssumption",
                      "labelDefinition",
                      "missingFields"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200000
              },
              "positiveRows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200000
              }
            },
            "required": [
              "sourceId",
              "kind",
              "rowSchema",
              "rawDemoSha256",
              "recordingId",
              "declaredMatchGroup",
              "identityQuality",
              "parserVersion",
              "sampling",
              "rows",
              "positiveRows"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "demo-derived"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "rowSchema": {
                      "const": "demo-live36-v1"
                    },
                    "rawDemoSha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "parserVersion": {
                      "const": "demo-v2-live.1"
                    },
                    "sampling": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "const": "periodic-live"
                        },
                        "stepTicks": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        "horizonTicks": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        "tickrateAssumption": {
                          "const": 64
                        },
                        "labelDefinition": {
                          "const": "damage_or_kill_in_(tick,tick+horizon]"
                        },
                        "missingFields": {
                          "const": "armor_helmet_flash_defuse_bomb_ammo_approx"
                        }
                      },
                      "required": [
                        "method",
                        "stepTicks",
                        "horizonTicks",
                        "tickrateAssumption",
                        "labelDefinition",
                        "missingFields"
                      ],
                      "additionalProperties": false
                    },
                    "identityQuality": {
                      "type": "string",
                      "enum": [
                        "recording-only",
                        "filename-inferred",
                        "user-declared"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "rowSchema": {
                      "const": "legacy26-v1"
                    },
                    "rawDemoSha256": {
                      "const": null
                    },
                    "parserVersion": {
                      "const": null
                    },
                    "sampling": {
                      "const": null
                    },
                    "identityQuality": {
                      "const": "unknown"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "sourceId": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8388608
              },
              "expandedBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50000
              },
              "positiveRows": {
                "type": "integer",
                "minimum": 0,
                "maximum": 50000
              },
              "partCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "required": [
              "index",
              "sourceId",
              "sha256",
              "contentSha256",
              "bytes",
              "expandedBytes",
              "rows",
              "positiveRows",
              "partCount"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024
        },
        "totals": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200000
            },
            "positiveRows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200000
            },
            "compressedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            },
            "expandedBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 536870912
            }
          },
          "required": [
            "sources",
            "files",
            "rows",
            "positiveRows",
            "compressedBytes",
            "expandedBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "version",
        "producerVersion",
        "featureVersion",
        "sources",
        "files",
        "totals"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "clientDatasetId",
    "runId",
    "manifestSha256",
    "manifest"
  ],
  "additionalProperties": false
}
