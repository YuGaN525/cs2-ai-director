{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "model": {
      "type": "string",
      "maxLength": 64
    },
    "inputPerMillion": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,8})?$"
    },
    "cachedInputPerMillion": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,8})?$"
    },
    "outputPerMillion": {
      "type": "string",
      "pattern": "^\\d{1,12}(\\.\\d{1,8})?$"
    },
    "apiKey": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "writeOnly": true
    },
    "clearKey": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "requestId",
    "expectedVersion",
    "enabled",
    "model",
    "inputPerMillion",
    "cachedInputPerMillion",
    "outputPerMillion",
    "apiKey",
    "clearKey",
    "reason"
  ]
}
