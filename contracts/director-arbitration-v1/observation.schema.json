{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "received",
        "applied",
        "discarded"
      ]
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    }
  },
  "required": [
    "state",
    "elapsedMs"
  ]
}
